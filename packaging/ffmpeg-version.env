# SPDX-License-Identifier: GPL-3.0-or-later
# CFA4's pinned FFmpeg: the one place its version is set (docs/plans/CFA4-FFMPEG-9.1-001.md, F0, R1).
# Shell scripts source this file, the workflows load its CFA4_FFMPEG_* lines into $GITHUB_ENV,
# build.rs and the Python tools read it. Plain KEY=VALUE lines only (no spaces, no quotes, no
# expansions), so every reader can parse it. scripts/ci/check_ffmpeg_version.py checks that the
# version is not written anywhere else (exceptions: packaging/ffmpeg-version-allowlist.txt).

# FFmpeg release, its upstream source tarball (https://ffmpeg.org/releases/ffmpeg-VERSION.tar.xz)
# and the tag commit of the GitHub mirror (https://github.com/FFmpeg/FFmpeg, tag nVERSION).
# 9.1: tarball signature checked against the FFmpeg release signing key
# FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8 and its content against the n9.1 tag (2026-11-24).
CFA4_FFMPEG_VERSION=9.1
CFA4_FFMPEG_SOURCE_SHA256=1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433
CFA4_FFMPEG_GIT_COMMIT=74e4393595cf2b5857f0da925c4e0dd74ea306e5

# Oldest FFmpeg the cfa4-ffmpeg backend accepts at run time (crates/ffmpeg MIN_VERSION).
CFA4_FFMPEG_MIN_VERSION=9.1

# Prebuilt base build (GitHub prerelease made by .github/workflows/cfa4-ffmpeg-prebuilt.yml,
# installed by scripts/dev/fetch-ffmpeg.sh): release tag and the archives' SHA-256 per host.
# An empty hash means not published yet: fetch-ffmpeg.sh then reports no prebuilt (exit 3) and
# build-ffmpeg.sh compiles from source.
CFA4_FFMPEG_PREBUILT_TAG=ffmpeg-9.1-cfa4-1
CFA4_FFMPEG_PREBUILT_SHA256_UBUNTU_26_04=f5d4119adaaac25a2b96236d6e946913baaecc87b122ed1daac97fd2173d3761
CFA4_FFMPEG_PREBUILT_SHA256_UBUNTU_24_04=ed07c5d8807896a93121b9716e65051e8e28b106f88874df486bce522c1a16c9

# Revision of the CI oracle cache (scripts/ci/install-ffmpeg.sh, actions/cache keys); raise it
# when the oracle's configure flags change without a version change.
CFA4_FFMPEG_CACHE_REV=v10

# AMD AMF SDK headers (MIT) for --enable-amf (plan D2): not packaged in Ubuntu 26.04, so taken from
# the pinned tag of https://github.com/GPUOpen-LibrariesAndSDKs/AMF (FFmpeg 9.1 needs >= 1.5.2).
# Only headers: the AMF runtime comes with AMD's driver and is loaded at run time.
CFA4_AMF_HEADERS_TAG=v1.5.3
CFA4_AMF_HEADERS_COMMIT=57ee0cfb0e1a08d9041f77435653794c1b012be0
