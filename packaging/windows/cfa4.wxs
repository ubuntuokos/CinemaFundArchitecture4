<?xml version="1.0" encoding="utf-8"?>
<!--
  CFA4 MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build cfa4.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="CFA4"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="CFA4 video editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of CFA4 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ubuntuokos/CinemaFundArchitecture4" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ubuntuokos/CinemaFundArchitecture4" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ubuntuokos/CinemaFundArchitecture4/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CFA4" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="CFA4" Level="1">
      <ComponentGroupRef Id="Cfa4Files" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="Cfa4Files" Directory="INSTALLFOLDER">
      <Component Id="Cfa4App" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="Cfa4Exe" Source="$(var.BinDir)\cfa4.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="CFA4"
              Description="CFA4 video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\cfa4.exe" Value="[#Cfa4Exe]" Type="string" />
      </Component>

      <Component Id="Cfa4Cli">
        <File Id="Cfa4CliExe" Source="$(var.BinDir)\cfa4-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
