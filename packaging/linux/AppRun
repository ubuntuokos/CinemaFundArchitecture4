#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# The CFA4 AppImage's entry point. It starts the egui app (bin/cfa4), as the desktop entry does
# until egui is retired, or the Qt 6 GUI (bin/cfa4-qt, with the PySide6 and Qt the AppImage
# carries in lib/cfa4/pyside6; docs/qt-parity.md 1.10) when asked:
#
#   ./cfa4-<version>-linux-x86_64.AppImage --qt [cfa4-qt options]
#   CFA4_GUI=qt ./cfa4-<version>-linux-x86_64.AppImage [cfa4-qt options]
here="$(dirname "$(readlink -f "$0")")"
gui="${CFA4_GUI:-}"
case "${1:-}" in
  --qt) gui=qt; shift ;;
  --egui) gui=egui; shift ;;
esac
if [ "$gui" = qt ]; then
  # Ubuntu 26.04 desktops have python3 (the PySide6 bundle is abi3: any Python 3.10 or newer)
  if ! command -v python3 >/dev/null 2>&1; then
    echo "cfa4: the Qt GUI needs python3 (sudo apt install python3)" >&2
    exit 1
  fi
  exec python3 "$here/usr/bin/cfa4-qt" "$@"
fi
exec "$here/usr/bin/cfa4" "$@"
