#!/usr/bin/python3
"""Start the installed CFA4 Qt 6 GUI (``cfa4-qt``).

The GUI's Python package sits in ``<prefix>/lib/cfa4/python`` next to this launcher's
``<prefix>/bin``, so the .deb (/usr) and the tarball installed with install.sh (~/.local or any
prefix) both work. PySide6 comes from Ubuntu's archive (python3-pyside6.*), never bundled. The
engine is the ``cfa4-cli`` installed beside this launcher unless CFA4_ENGINE or --engine names
another one.
"""

import os
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib" / "cfa4" / "python"))
ENGINE = BIN / "cfa4-cli"
if not os.environ.get("CFA4_ENGINE") and ENGINE.is_file():  # an empty value names no engine
    os.environ["CFA4_ENGINE"] = str(ENGINE)

QT_MODULES = ("QtCore", "QtGui", "QtWidgets", "QtNetwork", "QtTest")
try:  # before the GUI starts: its own message would advise a pip install, not Ubuntu's packages
    for module in QT_MODULES:
        __import__(f"PySide6.{module}")
except ModuleNotFoundError as e:
    if not (e.name or "").startswith("PySide6"):
        raise
    packages = " ".join(f"python3-pyside6.{m.lower()}" for m in (*QT_MODULES, "QtMultimedia"))
    sys.stderr.write(f"cfa4-qt: {e}\nThe Qt GUI needs Ubuntu's PySide6 packages: sudo apt install {packages}\n")
    sys.exit(1)

from cfa4_qt.__main__ import main  # noqa: E402

sys.exit(main())
