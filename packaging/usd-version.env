# SPDX-License-Identifier: GPL-3.0-or-later
# CFA4's pinned 3D donor sources (docs/plans/CFA4-PIXAR-DONOR-001-EGYESITETT-1.1.md, G-USD-1 path (b);
# docs/plans/CFA4-OPENUSD-SOURCEBUILD-001-0.1.md): the one place their versions are set.
# Plain KEY=VALUE lines only (no spaces, no quotes, no expansions), so shell scripts and Python can read them.
#
# Nothing here is downloaded automatically: scripts/dev/fetch-usd-source.sh does it, by hand, with --yes,
# or checks a tarball you got yourself (--from-tarball). Each source is pinned by the commit of the upstream
# tag (the git SHA-1) and by CFA4's own SHA-256 of the *uncompressed* `git archive --format=tar` of that
# commit (the same bytes from two separate fetches on 2026-11-27, git 2.43.0), plus the SHA-256 of its licence
# files. The SHA-256 is of the archive, not of GitHub's generated tarballs (their bytes are not guaranteed).
#
# Tag signature (D-SB-4, accepted by the owner 2026-11-27): the OpenUSD tag is annotated and carries an SSH
# signature (tagger pixar-oss). SIGNATURE_VERIFIED=tofu means: the signature is checked against the key in
# packaging/usd-allowed-signers, which was accepted on first use plus GitHub "Verified". Pixar publishes no
# fingerprint of its own, so this is NOT an official authentication (docs/plans/CFA4-OPENUSD-SOURCEBUILD-001-D-SB-4-JELOLT.md).
# Values: yes (officially authenticated), tofu (as above), no (not checked). The commit SHA and the SHA-256
# below stay the primary anchors.

# OpenUSD (https://github.com/PixarAnimationStudios/OpenUSD), licence TOST-1.0 (Apache-2.0 except section 6).
CFA4_USD_VERSION=26.11.1
CFA4_USD_GIT_URL=https://github.com/PixarAnimationStudios/OpenUSD
CFA4_USD_GIT_TAG=v26.11.1
CFA4_USD_TAG_OBJECT=d3b468cc1f4ec9f7acf84df774fc4d3a776d03ea
CFA4_USD_GIT_COMMIT=96c1989167d2aaab5bd34627f32a321a6b79866b
CFA4_USD_SOURCE_SHA256=6577d11be76d0413645fa7913aa66f2ab345ccd38c54176b28bf2ba6c314b9c0
CFA4_USD_LICENSE_SHA256=4d6e8e3a9bd0104e10c48e3bc6af2f0976448a70a377d20cef674740f96f4452
CFA4_USD_NOTICE_SHA256=f6ad9d41f77b1bd8edaecd64bd1e13f4224876b010e2415e308267a84862bc14
CFA4_USD_SIGNATURE_VERIFIED=tofu
CFA4_USD_SIGNING_KEY_SHA256=SHA256:qwkmpTioL2use1ERFDXTRPH1ucQs7E2tRG+RjzQh+k8
CFA4_USD_ALLOWED_SIGNERS=packaging/usd-allowed-signers

# OpenSubdiv (https://github.com/PixarAnimationStudios/OpenSubdiv), "Modified Apache 2.0". The version the
# OpenUSD release is tested with (needed for the F3 phase only; not part of the minimal OpenUSD core).
CFA4_OPENSUBDIV_VERSION=3.6.1
CFA4_OPENSUBDIV_GIT_URL=https://github.com/PixarAnimationStudios/OpenSubdiv
CFA4_OPENSUBDIV_GIT_TAG=v3_6_1
CFA4_OPENSUBDIV_GIT_COMMIT=f26d0dedeaf846ea321865a527bb4489691c2f04
CFA4_OPENSUBDIV_SOURCE_SHA256=25e5373227d1173fe167e19db364ad61b7c473f4b7eeda169d479cb21c22bf13
CFA4_OPENSUBDIV_LICENSE_SHA256=c52718780b46e8c7ea48b9ae0406061d4918761e385b6e024571a37c6d02dd95
CFA4_OPENSUBDIV_NOTICE_SHA256=c9a283f0d3752b74d348a57e1d45e71cf69651ce6cbdce866983e459f6422c7c
CFA4_OPENSUBDIV_SIGNATURE_VERIFIED=no

# oneTBB (https://github.com/oneapi-src/oneTBB), Apache-2.0: the only external library of the minimal OpenUSD
# core. 2021.12.0 is the version Pixar tests OpenUSD 26.11.1 with (VERSIONS.md); Ubuntu 26.04 ships 2022.3.0-2.
CFA4_ONETBB_VERSION=2021.12.0
CFA4_ONETBB_GIT_URL=https://github.com/oneapi-src/oneTBB
CFA4_ONETBB_GIT_TAG=v2021.12.0
CFA4_ONETBB_GIT_COMMIT=9afd759b72c0c233cd5ea3c3c06b0894c9da9c54
CFA4_ONETBB_SOURCE_SHA256=bf14f05ed3cf4954cd46bdb3ba24045c61157379b841692a4927e9a5beb8a052
CFA4_ONETBB_LICENSE_SHA256=c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4
CFA4_ONETBB_NOTICE_SHA256=
CFA4_ONETBB_SIGNATURE_VERIFIED=no
